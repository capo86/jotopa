# Copiar a .env.local y completar con los valores públicos del proyecto Supabase.
# Nunca colocar service_role ni secretos del servidor en variables VITE_.
# Supabase Local (sin claves de ejemplo).
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Clave sb_publishable_... (recomendada) o JWT con rol anon.
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5174

